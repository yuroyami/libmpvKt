<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="libmpvKt sample"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <!-- One core per process: every screen holds its own, so each runs in its own. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:process=":mpvlib"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ViewActivity"
            android:exported="true"
            android:process=":view"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <activity
            android:name=".TextureActivity"
            android:exported="true"
            android:process=":texture"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <activity
            android:name=".ComposeActivity"
            android:exported="true"
            android:process=":compose"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <activity
            android:name=".ComposePlayerActivity"
            android:exported="true"
            android:process=":composeplayer"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
    </application>

</manifest>
